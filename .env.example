# ===== ProjectHub 环境变量示例 =====
# 复制为 .env 或在启动前设置环境变量。请勿把真实密钥提交到代码仓库。

# 服务端口（默认 8787）
PORT=8787
# 生产环境请设置为 production（会影响健康检查与启动校验行为）
NODE_ENV=production

# ---- 管理员账号（必填，代码中没有任何默认密码）----
# 首次启动前必须提供管理员密码，否则服务会拒绝启动；账号已存在时不会覆盖密码。
# 更换密码：ADMIN_PASSWORD="新密码" node server.js --rotate-admin-password
ADMIN_NICKNAME=whitewater
ADMIN_PASSWORD=replace-with-a-long-random-password

# ---- 跨域白名单（留空 = 不开放跨域；支持逗号分隔）----
ALLOWED_ORIGINS=https://your-domain.example

# ---- 反向代理 ----
# 部署在 Nginx / Cloudflare 后面时设为 1，限流与审计才会使用真实客户端 IP
TRUST_PROXY=1

# ================= 资源上限（可按需调整） =================
# MAX_BODY_BYTES=8388608          # 请求体上限（8MB，够 5MB 文件的 base64）
# MAX_JSON_DEPTH=8                # JSON 最大嵌套层数
# MAX_JSON_ARRAY=200              # 数组最大元素数
# MAX_JSON_STRING=2000            # 普通字符串字段最大长度
# MAX_FILE_BYTES=5242880          # 单个上传文件上限（5MB）
# MAX_FILES_PER_TOPIC=200         # 单项目文件数量上限
# MAX_STORAGE_PER_USER=52428800   # 单用户上传总容量上限（50MB）
# MAX_INFLIGHT_GLOBAL=200         # 全局并发请求上限
# MAX_INFLIGHT_PER_IP=20          # 单 IP 并发请求上限
# MAX_SSE_TOTAL=200               # 全站 SSE 连接上限
# MAX_SSE_PER_IP=5                # 单 IP SSE 连接上限
# SSE_IDLE_MS=1800000             # SSE 空闲回收时间（30 分钟）
# REQUEST_TIMEOUT_MS=30000        # 普通请求超时
# AI_TIMEOUT_MS=120000            # AI 请求超时
# MAX_AI_CONCURRENT=2             # AI 并发上限
# RATE_LOGIN_IP=10                # 单个 IP 登录窗口内允许次数
# RATE_LOGIN_ACCOUNT=5            # 单账号连续失败次数（触发临时锁定）
# RATE_REGISTER_IP=5              # 单 IP 注册窗口内允许次数
# RATE_API_IP=300                 # 单 IP API 总请求窗口上限
# RATE_MESSAGE_USER=30            # 单用户发言频率上限
# RATE_UPLOAD_USER=10             # 单用户上传频率上限
# RATE_AI_TOPIC=10                # 单项目 AI 调用频率上限

# ================= AI 模型（可选，不配置则使用内置本地演示模式） =================
# 1) 本机开源模型：Ollama(11434) / LM Studio(1234) / Xinference(9997) / llama.cpp(8080) 会被自动探测
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b

# 2) DeepSeek
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# DEEPSEEK_MODEL=deepseek-chat

# 3) OpenAI 官方 API
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-5.6

# 4) 任意 OpenAI 兼容服务（硅基流动 / 阿里云百炼 / 智谱 GLM 等）
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# 5) 可选：联网检索（Tavily）
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx
