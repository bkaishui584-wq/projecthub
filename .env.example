# ===== ProjectHub 环境变量示例 =====
# 复制为 .env 或在启动前设置环境变量。请勿把真实密钥提交到代码仓库。

# 服务端口（默认 8787）
PORT=8787

# 管理员账号（首次启动时自动创建；生产环境请务必改成自己的密码）
ADMIN_NICKNAME=whitewater
ADMIN_PASSWORD=change-me-please

# ================= AI 模型（可选，不配置则使用内置的本地演示模式） =================

# 1) 本机开源模型：Ollama(11434) / LM Studio(1234) / Xinference(9997) / llama.cpp(8080) 会被自动探测，通常无需配置
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b

# 2) DeepSeek
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# DEEPSEEK_MODEL=deepseek-chat

# 3) OpenAI 官方 API
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-5.6

# 4) 任意 OpenAI 兼容服务（硅基流动 / 阿里云百炼 / 智谱 GLM / vLLM 等）
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# 5) 可选：联网检索（Tavily）
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx
